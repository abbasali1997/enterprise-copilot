<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Invitation to {{organizationName}}</title>
</head>
<body style="margin:0;padding:0;background-color:#f1f5f9;font-family:Arial,Helvetica,sans-serif;color:#0f172a;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:#f1f5f9;">
    <tr>
        <td align="center" style="padding:32px 16px;">
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0"
                   style="max-width:560px;background-color:#ffffff;border:1px solid #e2e8f0;border-radius:16px;">
                <tr>
                    <td style="padding:32px;">
                        <p style="margin:0 0 24px;font-size:14px;font-weight:bold;color:#4f46e5;">Enterprise Copilot</p>
                        <h1 style="margin:0 0 16px;font-size:26px;line-height:1.3;">You're invited
                            to {{organizationName}}</h1>
                        <p style="font-size:16px;line-height:1.6;">{{inviterName}} has invited you to
                            join {{organizationName}}.</p>
                        <p style="font-size:16px;line-height:1.6;">Your group: <strong>{{groupName}}</strong><br>Your
                            role: <strong>{{roleName}}</strong></p>

                        <div style="border-radius: 50% ;display:flex;padding:14px 24px;color:#ffffff;font-size:16px;font-weight:bold;text-decoration:none;justify-content: center">
                            <a href="{{invitationUrl}}">
                                <button style="border-radius:5px;padding: 10px 15px 10px 15px;color: white;background: rebeccapurple">
                                    Review Invitation
                                </button>
                            </a>
                        </div>

                        <p style="font-size:14px;line-height:1.6;color:#475569;">You can accept or decline on the
                            invitation page. This invitation expires on {{expiresAt}}.</p>
                        <p style="font-size:14px;line-height:1.6;color:#475569;">If the button doesn't work, copy this
                            link into your browser:<br><a href="{{invitationUrl}}"
                                                          style="color:#4f46e5;word-break:break-all;">{{invitationUrl}}</a>
                        </p>
                        <p style="margin-top:24px;font-size:12px;line-height:1.6;color:#64748b;">This invitation was
                            sent to {{email}}. If you weren't expecting it, you can ignore this email.</p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
