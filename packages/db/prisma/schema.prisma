/**

• User → OrganizationMember: One user can have many memberships; each membership belongs to one user.
• Organization → OrganizationMember: One organization can have many memberships; each membership belongs to one organization.
• User → Conversation: One user can have many conversations; each conversation belongs to one user.
• Organization → Conversation: One organization can have many conversations; each conversation belongs to one organization.
• Conversation → Message: One conversation can have many messages; each message belongs to one conversation.
• User → Message: One user can have many messages; each message optionally belongs to one user.

 **/

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum MessageStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  passwordHash String
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastLoginAt  DateTime?

  conversations Conversation[]
  memberships   OrganizationMember[]
  messages      Message[]
}

model Organization {
  id        String             @id @default(uuid())
  name      String
  slug      String             @unique
  logoUrl   String?
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  members       OrganizationMember[]
  conversations Conversation[]
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Conversation {
  id             String             @id @default(uuid())
  organizationId String
  userId         String
  assistantId    String
  title          String
  status         ConversationStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  lastMessageAt  DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages Message[]

  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, userId])
  @@index([lastMessageAt])
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  userId         String?
  role           MessageRole
  content        String
  model          String?
  metadata       Json?
  status         MessageStatus @default(COMPLETED)
  inputTokens    Int?
  outputTokens   Int?
  latencyMs      Int?
  errorMessage   String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
}
