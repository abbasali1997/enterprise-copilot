/**
 * • User → OrganizationMember: One user can have many memberships; each membership belongs to one user.
 * • Organization → OrganizationMember: One organization can have many memberships; each membership belongs to one organization.
 * • User → Conversation: One user can have many conversations; each conversation belongs to one user.
 * • Organization → Conversation: One organization can have many conversations; each conversation belongs to one organization.
 * • Conversation → Message: One conversation can have many messages; each message belongs to one conversation.
 * • User → Message: One user can have many messages; each message optionally belongs to one user.
 */

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrganizationInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  REVOKED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum MessageStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
  CANCELLED
}

enum LlmRequestStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AttachmentType {
  BINARY
  IMAGE
  DOCUMENT
}

enum AttchmentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  passwordHash String
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastLoginAt  DateTime?

  conversations Conversation[]
  memberships   OrganizationMember[]
  messages      Message[]

  invitationsSent     OrganizationInvitation[] @relation("InvitationsSent")
  invitationsAccepted OrganizationInvitation[] @relation("InvitationsAccepted")
}

model Organization {
  id        String             @id @default(uuid())
  name      String
  slug      String             @unique
  logoUrl   String?
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  members                 OrganizationMember[]
  conversations           Conversation[]
  organizationInvitations OrganizationInvitation[]
  attachments             Attachment[]
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model OrganizationInvitation {
  id               String                       @id @default(uuid())
  email            String
  organizationId   String
  role             OrganizationRole             @default(MEMBER)
  invitedByUserId  String
  acceptedByUserId String?
  tokenHash        String                       @unique
  status           OrganizationInvitationStatus @default(PENDING)
  expiresAt        DateTime                     @default(dbgenerated("(now() + interval '48 hours')"))
  createdAt        DateTime                     @default(now())
  respondedAt      DateTime?

  invitedByUser  User         @relation("InvitationsSent", fields: [invitedByUserId], references: [id])
  acceptedByUser User?        @relation("InvitationsAccepted", fields: [acceptedByUserId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([organizationId, email])
  @@index([organizationId, email, status])
}

model Conversation {
  id             String             @id @default(uuid())
  organizationId String
  userId         String
  assistantId    String
  title          String
  status         ConversationStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  lastMessageAt  DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages Message[]

  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, userId])
  @@index([lastMessageAt])
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  userId         String?
  role           MessageRole
  content        String
  model          String?
  metadata       Json?
  status         MessageStatus @default(COMPLETED)
  inputTokens    Int?
  outputTokens   Int?
  latencyMs      Int?
  errorMessage   String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LlmRequest {
  id String @id

  conversationId String?
  messageId      String?

  provider String
  model    String

  providerResponseId String?

  status LlmRequestStatus

  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?

  latencyMs Int?

  finishReason String?

  errorCode    String?
  errorMessage String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

model Attachment {
  id             String          @id @default(uuid())
  organizationId String
  key            String          @unique
  name           String
  status         AttchmentStatus @default(UPLOADED)
  type           AttachmentType
  mimeType       String
  fileSize       Int
  source         String

  organization Organization    @relation(references: [id], fields: [organizationId], onDelete: Cascade)
  chunks       DocumentChunk[]
}

model DocumentChunk {
  id         String                 @id @default(uuid())
  documentId String
  pageNumber Int
  chunkIndex Int
  content    String
  embedding  Unsupported("vector")?
  modelName  String                 @default("gemini-embedding-2")
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  document Attachment @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, pageNumber, chunkIndex])
}
